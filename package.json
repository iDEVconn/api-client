{
  "name": "@idevconn/api-client",
  "version": "0.3.1",
  "description": "Tiny JWT fetch wrapper with auto refresh, typed errors, and pluggable callbacks. Framework-agnostic. ~80 LOC. Zero runtime deps.",
  "license": "Apache-2.0",
  "author": "iDEVconn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDEVconn/api-client.git"
  },
  "bugs": {
    "url": "https://github.com/iDEVconn/api-client/issues"
  },
  "homepage": "https://github.com/iDEVconn/api-client#readme",
  "keywords": [
    "fetch",
    "jwt",
    "api-client",
    "token-refresh",
    "http",
    "typed-errors"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
